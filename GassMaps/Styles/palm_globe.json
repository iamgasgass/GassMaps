{
 "version": 8,
 "name": "GassMaps globe palm",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#738372"
   }
  },
  {
   "id": "landcover-ice",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "ice"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#e8eef0"
   }
  },
  {
   "id": "landcover-sand",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "sand"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#cdbf94"
   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "wood",
     "forest"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#6f8c5c",
    "fill-opacity": 0.8
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#607da7"
   }
  },
  {
   "id": "boundary-country",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "all",
    [
     "==",
     [
      "get",
      "admin_level"
     ],
     2
    ],
    [
     "!=",
     [
      "get",
      "maritime"
     ],
     1
    ]
   ],
   "paint": {
    "line-color": "#4f4f4f",
    "line-opacity": 0.55,
    "line-width": 0.8
   }
  },
  {
   "id": "road-motorway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk"
    ],
    true,
    false
   ],
   "paint": {
    "line-color": "#fff8e3",
    "line-opacity": 0.35,
    "line-width": 0.5
   }
  }
 ]
}