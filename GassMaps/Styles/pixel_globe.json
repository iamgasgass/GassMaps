{
 "version": 8,
 "name": "GassMaps globe pixel",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#79b64c"
   }
  },
  {
   "id": "landcover-ice",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "ice"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#f4f7f7"
   }
  },
  {
   "id": "landcover-sand",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "sand"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#ddd08f"
   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "wood",
     "forest"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#4f8f2f",
    "fill-opacity": 0.8
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#3d3ad6"
   }
  },
  {
   "id": "boundary-country",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "all",
    [
     "==",
     [
      "get",
      "admin_level"
     ],
     2
    ],
    [
     "!=",
     [
      "get",
      "maritime"
     ],
     1
    ]
   ],
   "paint": {
    "line-color": "#c0392b",
    "line-opacity": 0.55,
    "line-width": 0.8
   }
  },
  {
   "id": "road-motorway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk"
    ],
    true,
    false
   ],
   "paint": {
    "line-color": "#e8d9a5",
    "line-opacity": 0.35,
    "line-width": 0.5
   }
  },
  {
   "id": "place-city",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "all",
    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "city"
     ],
     true,
     false
    ],
    [
     "<=",
     [
      "to-number",
      [
       "get",
       "rank"
      ],
      10
     ],
     4
    ]
   ],
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name:latin"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": 8,
    "text-transform": "none",
    "text-anchor": "left",
    "text-offset": [
     0.5,
     0
    ],
    "icon-image": "gm-dot",
    "icon-size": 0.5
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "#1d1d4a",
    "text-halo-width": 1
   }
  },
  {
   "id": "place-country",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "country"
    ],
    true,
    false
   ],
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name:latin"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": 9,
    "text-transform": "none",
    "text-max-width": 6
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "#1d1d4a",
    "text-halo-width": 1.2
   }
  }
 ]
}