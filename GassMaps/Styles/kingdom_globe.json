{
 "version": 8,
 "name": "GassMaps globe kingdom",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#8a6f4a"
   }
  },
  {
   "id": "landcover-ice",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "ice"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#e3d3b0"
   }
  },
  {
   "id": "landcover-sand",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "sand"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#c7a46c"
   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "wood",
     "forest"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#a6844f",
    "fill-opacity": 0.8
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#6f7a62"
   }
  },
  {
   "id": "boundary-country",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "all",
    [
     "==",
     [
      "get",
      "admin_level"
     ],
     2
    ],
    [
     "!=",
     [
      "get",
      "maritime"
     ],
     1
    ]
   ],
   "paint": {
    "line-color": "#4a3520",
    "line-opacity": 0.55,
    "line-width": 0.8
   }
  },
  {
   "id": "road-motorway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk"
    ],
    true,
    false
   ],
   "paint": {
    "line-color": "#f3e2bb",
    "line-opacity": 0.35,
    "line-width": 0.5
   }
  }
 ]
}